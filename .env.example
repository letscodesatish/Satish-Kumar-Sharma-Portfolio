# Contact form email (Gmail example)
# 1. Turn on 2-Step Verification for your Google account
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Copy this file to .env.local and fill in the values
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=satish.21.buv@gmail.com
SMTP_PASS=your-16-char-app-password
CONTACT_TO=satish.21.buv@gmail.com

# Optional: GitHub token (no scopes needed). Makes the contribution graph use the official API
# and raises the API limit from 60 to 5000 requests/hour.
# GITHUB_TOKEN=
